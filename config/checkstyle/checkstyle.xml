<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Guardrails for patterns Error Prone/NullAway don't check for. Add a
  RegexpSinglelineJava module below for each new banned pattern, with a
  message that says what to write instead.
-->
<module name="Checker">
    <module name="TreeWalker">
        <module name="RegexpSinglelineJava">
            <property name="format" value="\bObjects\.requireNonNull\("/>
            <property name="message"
                      value="Use a static import (import static java.util.Objects.requireNonNull;) instead of a qualified Objects.requireNonNull(...) call."/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
